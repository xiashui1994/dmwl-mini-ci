{
  "name": "dmwl-mini-ci",
  "type": "module",
  "version": "2.0.0",
  "private": true,
  "description": "微信小程序、小游戏CI发布工具",
  "author": "xiashui",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/xiashui1994/dmwl-mini-ci"
  },
  "keywords": [
    "miniprogram-ci",
    "miniprogram",
    "ci",
    "mini-ci"
  ],
  "exports": {
    ".": {
      "types": "./dist/dmwl-mini-ci.d.ts",
      "import": "./dist/dmwl-mini-ci.js"
    }
  },
  "module": "./dist/dmwl-mini-ci.js",
  "types": "./dist/dmwl-mini-ci.d.ts",
  "bin": {
    "dmwl-mini-ci": "./dist/commands/dmwl-ci.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": "^18.0.0 || >=20.0.0"
  },
  "scripts": {
    "prepare": "husky install",
    "build": "tsc && vite build && chmod +x dist/commands/dmwl-ci.js && cp -r lib/libs dist/",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "cli-table3": "^0.6.5",
    "commander": "^15.0.0",
    "fs-extra": "^11.4.0",
    "miniprogram-ci": "^2.1.31",
    "simple-git": "^3.36.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.3.0",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@microsoft/api-extractor": "^7.59.0",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.19.43",
    "eslint": "^10.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.0.3"
  }
}
